\PYG{n}{pozo} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}WELL\PYGZhy{}00001\PYGZus{}20170226130146\PYGZdq{}}
\PYG{n}{g} \PYG{o}{=} \PYG{n}{d}\PYG{p}{[}\PYG{n}{d}\PYG{o}{.}\PYG{n}{instancia} \PYG{o}{==} \PYG{n}{pozo}\PYG{p}{]}    \PYG{c+c1}{\PYGZsh{} tomamos UN pozo}

\PYG{c+c1}{\PYGZsh{} la primera hora es su \PYGZdq{}normal\PYGZdq{}}
\PYG{c+c1}{\PYGZsh{} (120 filas = 120 x 30 s = 1 hora)}
\PYG{n}{primera\PYGZus{}hora} \PYG{o}{=} \PYG{n}{g}\PYG{o}{.}\PYG{n}{p\PYGZus{}antes\PYGZus{}choke}\PYG{o}{.}\PYG{n}{iloc}\PYG{p}{[:}\PYG{l+m+mi}{120}\PYG{p}{]}

\PYG{n}{centro} \PYG{o}{=} \PYG{n}{primera\PYGZus{}hora}\PYG{o}{.}\PYG{n}{median}\PYG{p}{()}   \PYG{c+c1}{\PYGZsh{} valor tipico}
\PYG{n}{ancho}  \PYG{o}{=} \PYG{n}{primera\PYGZus{}hora}\PYG{o}{.}\PYG{n}{std}\PYG{p}{()}      \PYG{c+c1}{\PYGZsh{} cuanto se mueve}

\PYG{c+c1}{\PYGZsh{} cuantas desviaciones de distancia hay}
\PYG{c+c1}{\PYGZsh{} en cada instante}
\PYG{n}{z} \PYG{o}{=} \PYG{p}{(}\PYG{n}{g}\PYG{o}{.}\PYG{n}{p\PYGZus{}antes\PYGZus{}choke} \PYG{o}{\PYGZhy{}} \PYG{n}{centro}\PYG{p}{)} \PYG{o}{/} \PYG{n}{ancho}

\PYG{c+c1}{\PYGZsh{} la alarma suena si se pasa de 3}
\PYG{n}{suena} \PYG{o}{=} \PYG{n}{z}\PYG{o}{.}\PYG{n}{abs}\PYG{p}{()} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{3}
