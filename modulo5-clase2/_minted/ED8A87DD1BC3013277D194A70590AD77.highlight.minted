\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{preparar}\PYG{p}{(}\PYG{n}{g}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Traduce una grabacion a filas de tabla.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{X} \PYG{o}{=} \PYG{n}{pd}\PYG{o}{.}\PYG{n}{DataFrame}\PYG{p}{(}\PYG{n}{index}\PYG{o}{=}\PYG{n}{g}\PYG{o}{.}\PYG{n}{index}\PYG{p}{)}
    \PYG{k}{for} \PYG{n}{s} \PYG{o+ow}{in} \PYG{n}{SENSORES}\PYG{p}{:}
        \PYG{n}{v} \PYG{o}{=} \PYG{n}{g}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]}

        \PYG{c+c1}{\PYGZsh{} 1) su propia normal: la primera hora}
        \PYG{n}{centro} \PYG{o}{=} \PYG{n}{v}\PYG{o}{.}\PYG{n}{iloc}\PYG{p}{[:}\PYG{l+m+mi}{120}\PYG{p}{]}\PYG{o}{.}\PYG{n}{median}\PYG{p}{()}
        \PYG{n}{ancho}  \PYG{o}{=} \PYG{n}{v}\PYG{o}{.}\PYG{n}{iloc}\PYG{p}{[:}\PYG{l+m+mi}{120}\PYG{p}{]}\PYG{o}{.}\PYG{n}{std}\PYG{p}{()}

        \PYG{c+c1}{\PYGZsh{} 2) la senal en \PYGZdq{}desviaciones propias\PYGZdq{}}
        \PYG{n}{z} \PYG{o}{=} \PYG{p}{(}\PYG{n}{v} \PYG{o}{\PYGZhy{}} \PYG{n}{centro}\PYG{p}{)} \PYG{o}{/} \PYG{n}{ancho}
        \PYG{n}{X}\PYG{p}{[}\PYG{n}{s} \PYG{o}{+} \PYG{l+s+s2}{\PYGZdq{}\PYGZus{}\PYGZus{}base\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{z}

        \PYG{c+c1}{\PYGZsh{} 3) las tres componentes, sobre z}
        \PYG{n}{X}\PYG{p}{[}\PYG{n}{s} \PYG{o}{+} \PYG{l+s+s2}{\PYGZdq{}\PYGZus{}\PYGZus{}nivel\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{z}\PYG{o}{.}\PYG{n}{rolling}\PYG{p}{(}\PYG{l+m+mi}{60}\PYG{p}{)}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{()}
        \PYG{n}{X}\PYG{p}{[}\PYG{n}{s} \PYG{o}{+} \PYG{l+s+s2}{\PYGZdq{}\PYGZus{}\PYGZus{}ruido\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{z}\PYG{o}{.}\PYG{n}{rolling}\PYG{p}{(}\PYG{l+m+mi}{60}\PYG{p}{)}\PYG{o}{.}\PYG{n}{std}\PYG{p}{()}
        \PYG{n}{X}\PYG{p}{[}\PYG{n}{s} \PYG{o}{+} \PYG{l+s+s2}{\PYGZdq{}\PYGZus{}\PYGZus{}pend\PYGZdq{}}\PYG{p}{]}  \PYG{o}{=} \PYG{n}{z}\PYG{o}{.}\PYG{n}{diff}\PYG{p}{(}\PYG{l+m+mi}{60}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{X}
\end{MintedVerbatim}
